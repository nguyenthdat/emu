{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emu.rs/schemas/v1/research-ios.schema.json",
  "title": "EmuIosDarwinResearchSchema",
  "description": "Complete JSON Schema defining operational envelopes, entities, state machines, and event streams for iOS Root VM and Darwin Security Research Backends in Emu.",
  "$ref": "#/definitions/OutputEnvelope",
  "definitions": {
    "OutputEnvelope": {
      "type": "object",
      "required": ["status", "outcome", "operation_id", "data", "error"],
      "properties": {
        "$schema": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "already_satisfied",
            "accepted",
            "failed",
            "rejected",
            "timed_out",
            "cancelled"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "already_satisfied",
            "proposal_created",
            "auth_refused",
            "invalid_input",
            "unsupported",
            "conflict",
            "timeout",
            "cancellation_pending",
            "cancelled",
            "execution_failed"
          ]
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[0-9A-Za-z]+$"
        },
        "data": {
          "type": ["object", "null"]
        },
        "error": {
          "anyOf": [{ "$ref": "#/definitions/ErrorRecord" }, { "type": "null" }]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": { "enum": ["success"] },
            "outcome": {
              "enum": ["completed", "already_satisfied", "proposal_created"]
            },
            "error": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["already_satisfied"] },
            "outcome": { "enum": ["already_satisfied"] },
            "error": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["accepted"] },
            "outcome": { "enum": ["proposal_created"] },
            "error": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["failed"] },
            "outcome": { "enum": ["execution_failed"] },
            "error": { "$ref": "#/definitions/ErrorRecord" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["rejected"] },
            "outcome": {
              "enum": [
                "invalid_input",
                "unsupported",
                "auth_refused",
                "conflict"
              ]
            },
            "error": { "$ref": "#/definitions/ErrorRecord" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["timed_out"] },
            "outcome": { "enum": ["timeout"] },
            "error": { "$ref": "#/definitions/ErrorRecord" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["timed_out"] },
            "outcome": { "enum": ["cancellation_pending"] },
            "error": { "$ref": "#/definitions/ErrorRecord" }
          }
        },
        {
          "properties": {
            "status": { "enum": ["cancelled"] },
            "outcome": { "enum": ["cancelled"] },
            "error": { "$ref": "#/definitions/ErrorRecord" }
          }
        }
      ]
    },
    "StreamLogEnvelope": {
      "type": "object",
      "required": [
        "timestamp",
        "level",
        "event",
        "phase",
        "message",
        "operation_id"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"]
        },
        "event": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "preflight",
            "staging",
            "booting",
            "verifying",
            "settled",
            "recovering",
            "stopping",
            "cleanup",
            "teardown",
            "paused",
            "executing",
            "unknown"
          ]
        },
        "message": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[0-9A-Za-z]+$"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "ErrorRecord": {
      "type": "object",
      "required": ["code", "message", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_REQUIRED",
            "INVALID_INPUT",
            "UNSUPPORTED_HOST",
            "APP_FRAMEWORKS_UNAVAILABLE",
            "AMBIGUOUS_INSTANCE_NAME",
            "ARTIFACT_CORRUPTED",
            "EXPERIMENTAL_OPT_IN_REQUIRED",
            "MISSING_BASELINE",
            "CONCURRENCY_CONFLICT",
            "DEPENDENT_GUEST_ACTIVE",
            "TIMEOUT",
            "CANCELLED",
            "PROBE_VERIFICATION_FAILED",
            "DEBUG_LEASE_CONFLICT",
            "UNSAFE_MOUNT_DETECTED",
            "RUNTIME_EXECUTION_ERROR",
            "CANCELLATION_PENDING"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "BackendType": {
      "type": "string",
      "enum": ["darwin-vm", "Inferno"]
    },
    "InstanceLifecycleState": {
      "type": "string",
      "enum": [
        "stopped",
        "booting",
        "running",
        "paused",
        "recovering",
        "stopping",
        "error",
        "unknown"
      ]
    },
    "CpuArchitecture": {
      "type": "string",
      "enum": ["arm64"]
    },
    "PrivilegeState": {
      "type": "string",
      "enum": ["root", "unprivileged"]
    },
    "RootVerificationState": {
      "type": "string",
      "enum": ["unverified", "verifying", "verified", "invalidated"]
    },
    "FridaAttachmentState": {
      "type": "string",
      "enum": [
        "detached",
        "preparing",
        "ready",
        "attached",
        "detached_clean",
        "failed",
        "invalidated"
      ]
    },
    "DebugLeaseState": {
      "type": "string",
      "enum": ["active", "released", "expired", "disconnected_paused"]
    },
    "SupportStatus": {
      "type": "string",
      "enum": ["supported", "unsupported", "experimental"]
    },
    "ImageArtifactType": {
      "type": "string",
      "enum": [
        "kernelcache",
        "ramdisk",
        "devicetree",
        "trustcache",
        "root_disk",
        "sptm_firmware",
        "txm_firmware",
        "sep_firmware",
        "nvram_template",
        "ipsw_restore_bundle"
      ]
    },
    "ArtifactTrustStatus": {
      "type": "string",
      "enum": [
        "verified_trusted",
        "experimental_opt_in",
        "digest_mismatch_corrupt",
        "unverified_untrusted"
      ]
    },
    "BootArtifactMap": {
      "type": "object",
      "required": ["kernelcache", "devicetree"],
      "properties": {
        "kernelcache": { "$ref": "#/definitions/Sha256Digest" },
        "devicetree": { "$ref": "#/definitions/Sha256Digest" },
        "trustcache": { "$ref": "#/definitions/Sha256Digest" },
        "ramdisk": { "$ref": "#/definitions/Sha256Digest" },
        "root_disk": { "$ref": "#/definitions/Sha256Digest" },
        "sptm_firmware": { "$ref": "#/definitions/Sha256Digest" },
        "txm_firmware": { "$ref": "#/definitions/Sha256Digest" },
        "sep_firmware": { "$ref": "#/definitions/Sha256Digest" },
        "nvram_template": { "$ref": "#/definitions/Sha256Digest" },
        "ipsw_restore_bundle": { "$ref": "#/definitions/Sha256Digest" }
      },
      "additionalProperties": false
    },
    "AppDeploymentStatus": {
      "type": "string",
      "enum": [
        "imported",
        "installed",
        "running",
        "stopped",
        "removed",
        "incompatible"
      ]
    },
    "CodeSigningMode": {
      "type": "string",
      "enum": ["enforced", "adhoc_permitted", "disabled"]
    },
    "AmfiStatus": {
      "type": "string",
      "enum": ["enforced", "developer_mode", "amfi_get_out_of_my_way"]
    },
    "SandboxMode": {
      "type": "string",
      "enum": ["enforced", "audit_only", "relaxed"]
    },
    "MountMode": {
      "type": "string",
      "enum": ["read_only", "read_write"]
    },
    "KernelPrivilegeLevel": {
      "type": "string",
      "enum": ["stock", "root_console_enabled", "kernel_debug_enabled"]
    },
    "MutationType": {
      "type": "string",
      "enum": [
        "disk_wipe",
        "guest_wipe",
        "instance_delete",
        "baseline_restore",
        "baseline_delete",
        "security_policy_relax",
        "security_apply",
        "security_revert",
        "container_write",
        "container_export",
        "fs_write",
        "fs_export",
        "image_prepare_elevation",
        "image_overwrite",
        "image_prepare",
        "profile_apply"
      ]
    },
    "OperationStatus": {
      "type": "string",
      "enum": [
        "created",
        "preflight",
        "staged",
        "executing",
        "verifying",
        "completed",
        "failed",
        "cancellation_pending",
        "cancelled"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ResearchGuestInstance": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "backend",
        "lifecycle_state",
        "guest_arch",
        "guest_os_version",
        "build_identity",
        "config_revision",
        "base_image_ref",
        "boot_artifacts",
        "runtime_dir",
        "desired_privilege",
        "observed_privilege",
        "created_at",
        "updated_at",
        "last_settled_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "$ref": "#/definitions/BackendType"
        },
        "lifecycle_state": {
          "$ref": "#/definitions/InstanceLifecycleState"
        },
        "guest_arch": {
          "$ref": "#/definitions/CpuArchitecture"
        },
        "guest_os_version": {
          "type": "string"
        },
        "build_identity": {
          "type": "string"
        },
        "boot_session_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "config_revision": {
          "$ref": "#/definitions/Sha256Digest"
        },
        "base_image_ref": {
          "$ref": "#/definitions/Sha256Digest"
        },
        "boot_artifacts": {
          "$ref": "#/definitions/BootArtifactMap"
        },
        "profile_id": {
          "type": ["string", "null"]
        },
        "runtime_dir": {
          "type": "string"
        },
        "qmp_socket_path": {
          "type": ["string", "null"]
        },
        "gdb_socket_path": {
          "type": ["string", "null"]
        },
        "console_socket_path": {
          "type": ["string", "null"]
        },
        "active_session_id": {
          "type": ["string", "null"]
        },
        "security_profile_id": {
          "type": ["string", "null"]
        },
        "baseline_id": {
          "type": ["string", "null"]
        },
        "desired_privilege": {
          "$ref": "#/definitions/PrivilegeState"
        },
        "observed_privilege": {
          "$ref": "#/definitions/RootVerificationState"
        },
        "run_lock_path": {
          "type": ["string", "null"]
        },
        "device_lock_path": {
          "type": ["string", "null"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_settled_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "BackendCapabilityProfile": {
      "type": "object",
      "required": [
        "backend",
        "host_os",
        "host_arch",
        "hypervisor",
        "support_status",
        "supported_guest_families",
        "headless_console_support",
        "graphical_display_support",
        "companion_vm_required",
        "app_frameworks_supported",
        "supported_debug_interfaces",
        "capabilities",
        "required_binaries",
        "required_entitlements",
        "remediation_steps"
      ],
      "properties": {
        "backend": {
          "$ref": "#/definitions/BackendType"
        },
        "host_os": {
          "type": "string",
          "enum": ["macos"]
        },
        "host_arch": {
          "type": "string",
          "enum": ["aarch64"]
        },
        "hypervisor": {
          "type": "string",
          "enum": ["hypervisor_framework", "tcg_emulation"]
        },
        "support_status": {
          "$ref": "#/definitions/SupportStatus"
        },
        "supported_guest_families": {
          "type": "array",
          "items": { "type": "string" }
        },
        "headless_console_support": {
          "type": "boolean"
        },
        "graphical_display_support": {
          "type": "boolean"
        },
        "companion_vm_required": {
          "type": "boolean"
        },
        "app_frameworks_supported": {
          "type": "boolean"
        },
        "supported_debug_interfaces": {
          "type": "array",
          "items": { "type": "string", "enum": ["gdb_rsp", "qmp_monitor"] }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "root_shell",
            "kernel_debug",
            "app_frameworks",
            "dynamic_instrumentation",
            "companion_bridge"
          ],
          "properties": {
            "root_shell": { "$ref": "#/definitions/SupportStatus" },
            "kernel_debug": { "$ref": "#/definitions/SupportStatus" },
            "app_frameworks": { "$ref": "#/definitions/SupportStatus" },
            "dynamic_instrumentation": {
              "$ref": "#/definitions/SupportStatus"
            },
            "companion_bridge": { "$ref": "#/definitions/SupportStatus" }
          },
          "additionalProperties": false
        },
        "required_binaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["binary_name", "found"],
            "properties": {
              "binary_name": { "type": "string" },
              "found": { "type": "boolean" },
              "resolved_path": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "required_entitlements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "granted"],
            "properties": {
              "name": { "type": "string" },
              "granted": { "type": "boolean" },
              "details": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "remediation_steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "ResearchImageArtifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "file_path",
        "sha256_digest",
        "origin_metadata",
        "target_backend",
        "build_version_identity",
        "trust_status",
        "created_at"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_type": { "$ref": "#/definitions/ImageArtifactType" },
        "file_path": { "type": "string" },
        "sha256_digest": { "$ref": "#/definitions/Sha256Digest" },
        "origin_metadata": {
          "type": "object",
          "required": ["source_type", "build_identity"],
          "properties": {
            "source_type": {
              "type": "string",
              "enum": ["user_supplied", "prepared_recovery"]
            },
            "build_identity": { "type": "string" },
            "source_url_or_ref": { "type": "string" }
          },
          "additionalProperties": false
        },
        "target_backend": { "$ref": "#/definitions/BackendType" },
        "build_version_identity": { "type": "string" },
        "verified_device_node": { "type": ["string", "null"] },
        "verified_volume_uuid": { "type": ["string", "null"] },
        "trust_status": { "$ref": "#/definitions/ArtifactTrustStatus" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ProbeOutcome": {
      "type": "object",
      "required": [
        "path",
        "status",
        "target_user",
        "executed_euid",
        "expected_denial",
        "helper_executed",
        "output"
      ],
      "properties": {
        "path": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["success", "denied", "error", "unverified"]
        },
        "target_user": { "type": "string" },
        "executed_euid": { "type": "integer" },
        "expected_denial": { "type": "boolean" },
        "helper_executed": { "type": "boolean" },
        "syscall_errno": { "type": ["integer", "null"] },
        "syscall_error_name": { "type": ["string", "null"] },
        "content_verified": { "type": ["boolean", "null"] },
        "output": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RootProofEvidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "guest_id",
        "boot_session_id",
        "backend",
        "guest_build_identity",
        "image_artifact_digest",
        "config_revision_hash",
        "verification_state",
        "verified_at",
        "diagnostics"
      ],
      "properties": {
        "evidence_id": { "type": "string", "format": "uuid" },
        "guest_id": { "type": "string", "format": "uuid" },
        "boot_session_id": { "type": "string", "format": "uuid" },
        "backend": { "$ref": "#/definitions/BackendType" },
        "guest_build_identity": { "type": "string" },
        "image_artifact_digest": { "$ref": "#/definitions/Sha256Digest" },
        "config_revision_hash": { "$ref": "#/definitions/Sha256Digest" },
        "verified_uid": { "type": ["integer", "null"] },
        "positive_probe_outcome": {
          "anyOf": [
            { "$ref": "#/definitions/ProbeOutcome" },
            { "type": "null" }
          ]
        },
        "negative_control_outcome": {
          "anyOf": [
            { "$ref": "#/definitions/ProbeOutcome" },
            { "type": "null" }
          ]
        },
        "observed_kernel_version": { "type": ["string", "null"] },
        "observed_boot_args": { "type": ["string", "null"] },
        "benign_binary_digest": {
          "anyOf": [
            { "$ref": "#/definitions/Sha256Digest" },
            { "type": "null" }
          ]
        },
        "verification_state": { "$ref": "#/definitions/RootVerificationState" },
        "verified_at": { "type": "string", "format": "date-time" },
        "diagnostics": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "verification_state": { "enum": ["verified"] } }
          },
          "then": {
            "required": [
              "verified_uid",
              "positive_probe_outcome",
              "negative_control_outcome",
              "observed_kernel_version",
              "observed_boot_args",
              "benign_binary_digest"
            ],
            "properties": {
              "verified_uid": { "type": "integer", "enum": [0] },
              "positive_probe_outcome": {
                "type": "object",
                "required": [
                  "status",
                  "executed_euid",
                  "content_verified",
                  "helper_executed"
                ],
                "properties": {
                  "status": { "enum": ["success"] },
                  "executed_euid": { "enum": [0] },
                  "content_verified": { "enum": [true] },
                  "helper_executed": { "enum": [true] }
                }
              },
              "negative_control_outcome": {
                "type": "object",
                "required": [
                  "status",
                  "executed_euid",
                  "expected_denial",
                  "helper_executed",
                  "syscall_errno",
                  "syscall_error_name"
                ],
                "properties": {
                  "status": { "enum": ["denied"] },
                  "executed_euid": { "type": "integer", "minimum": 1 },
                  "expected_denial": { "enum": [true] },
                  "helper_executed": { "enum": [true] },
                  "syscall_errno": { "enum": [1, 13] },
                  "syscall_error_name": { "enum": ["EPERM", "EACCES"] }
                }
              },
              "observed_kernel_version": { "type": "string", "minLength": 1 },
              "observed_boot_args": { "type": "string" },
              "benign_binary_digest": { "$ref": "#/definitions/Sha256Digest" }
            }
          }
        }
      ]
    },
    "ApplicationArtifact": {
      "type": "object",
      "required": [
        "app_id",
        "bundle_identifier",
        "bundle_name",
        "package_path",
        "sha256_digest",
        "binary_architecture",
        "code_signature_identity",
        "entitlement_manifest",
        "deployment_status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "app_id": { "type": "string" },
        "bundle_identifier": { "type": "string" },
        "bundle_name": { "type": "string" },
        "package_path": { "type": "string" },
        "sha256_digest": { "$ref": "#/definitions/Sha256Digest" },
        "binary_architecture": { "$ref": "#/definitions/CpuArchitecture" },
        "code_signature_identity": { "type": "string" },
        "sandbox_container_path": { "type": ["string", "null"] },
        "entitlement_manifest": { "type": "object" },
        "deployment_status": { "$ref": "#/definitions/AppDeploymentStatus" },
        "target_guest_id": { "type": ["string", "null"], "format": "uuid" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "HookStatus": {
      "type": "object",
      "required": [
        "native_hooks_count",
        "objc_hooks_count",
        "events_intercepted"
      ],
      "properties": {
        "native_hooks_count": { "type": "integer", "minimum": 0 },
        "objc_hooks_count": { "type": "integer", "minimum": 0 },
        "events_intercepted": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "InstrumentationSession": {
      "type": "object",
      "required": [
        "session_id",
        "guest_id",
        "boot_session_id",
        "target_process_id",
        "agent_package_version",
        "agent_integrity_hash",
        "tls_server_cert_pinned",
        "session_token_configured",
        "injected_script_hashes",
        "hook_status",
        "attachment_state",
        "captured_hook_events_count",
        "control_process_hooked",
        "diagnostics"
      ],
      "properties": {
        "session_id": { "type": "string" },
        "guest_id": { "type": "string", "format": "uuid" },
        "boot_session_id": { "type": "string", "format": "uuid" },
